{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matraix.local/schemas/persona-candidates.schema.json",
  "title": "MatrAIx persona candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "persona",
    "source_coverage",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "display_name"
      ],
      "properties": {
        "persona_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "sources",
        "schema_categories_reviewed",
        "limitations"
      ],
      "properties": {
        "generated_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "schema_categories_reviewed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "description",
        "items_reviewed",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "enum": [
            "current_task",
            "memory",
            "chatgpt_history",
            "codex_history",
            "chatgpt_export",
            "user_file",
            "user_statement",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "items_reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "confidence",
        "evidence",
        "source_refs",
        "runtime_included"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "enum": [
            "stated",
            "strong_inference",
            "best_guess",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "runtime_included": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "unknown"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              },
              "runtime_included": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string"
              },
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
